{
  "name": "plantation-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moniruzjaman/plantation-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/moniruzjaman/plantation-tracker/issues"
  },
  "homepage": "https://github.com/moniruzjaman/plantation-tracker#readme",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node fix-gradle-wrapper.js && node chmod-gradlew.js && (node download-and-process-logo.js || echo '⚠️ Logo processing skipped - using existing assets') && node map.js && (node generate-android-icons.js || echo '⚠️ Android icon generation skipped - using existing assets') && vite build",
    "vercel-build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:migrate": "npx prisma migrate dev --name init"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@prisma/client": "^6.8.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.1",
    "fake-indexeddb": "^6.2.5",
    "prisma": "^6.8.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^54.14.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  }
}
