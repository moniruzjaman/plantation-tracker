// ============================================================
// Prisma Schema — Plantation Tracker Database Integration
// ============================================================
// Target: Neon PostgreSQL (auto-provisioned via Vercel Dashboard → Storage)
// Connection: POSTGRES_PRISMA_URL (injected by Vercel at build/runtime)
//
// Run:  npx prisma generate          (emit client)
//       npx prisma db push           (sync schema → DB without migration files)
//       npx prisma migrate dev       (proper migration with SQL files)
//
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DIRECT_POSTGRES_URL") // Optional: for migration commands
}

// ────────────────────────────────────────────────────────────
// Administrative Hierarchy (seeded once, read-heavy)
// ────────────────────────────────────────────────────────────

model Division {
  id          Int         @id @default(autoincrement())
  code        String      @unique // e.g. "BD-30" (BBS code)
  nameBn      String      @map("name_bn")   // e.g. "ঢাকা বিভাগ"
  nameEn      String      @map("name_en")   // e.g. "Dhaka Division"
  districts   District[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("divisions")
}

model District {
  id            Int         @id @default(autoincrement())
  divisionId    Int         @map("division_id")
  code          String      @unique // e.g. "BD-26" (BBS code)
  nameBn        String      @map("name_bn")   // e.g. "ঢাকা"
  nameEn        String      @map("name_en")   // e.g. "Dhaka"
  lat           Float?      // District centroid latitude
  lng           Float?      // District centroid longitude
  division      Division    @relation(fields: [divisionId], references: [id])
  upazilas      Upazila[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([divisionId])
  @@index([nameBn])
  @@index([nameEn])
  @@map("districts")
}

model Upazila {
  id          Int         @id @default(autoincrement())
  districtId  Int         @map("district_id")
  code        String      @unique // e.g. "BD-2626" (composite BBS code)
  nameBn      String      @map("name_bn")   // e.g. "ধামরাই"
  nameEn      String      @map("name_en")   // e.g. "Dhamrai"
  lat         Float?      // Upazila centroid latitude
  lng         Float?      // Upazila centroid longitude
  district    District    @relation(fields: [districtId], references: [id])
  unions      Union[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([districtId])
  @@index([nameBn])
  @@index([nameEn])
  @@map("upazilas")
}

model Union {
  id          Int         @id @default(autoincrement())
  upazilaId   Int         @map("upazila_id")
  nameBn      String      @map("name_bn")   // e.g. "যদুবয়রা"
  nameEn      String?     @map("name_en")   // English name (optional, may not be available for all)
  upazila     Upazila     @relation(fields: [upazilaId], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([upazilaId])
  @@index([nameBn])
  @@map("unions")
}

// ────────────────────────────────────────────────────────────
// Application Data (high-write, synced from Google Sheets)
// ────────────────────────────────────────────────────────────

model UserProfile {
  id            Int       @id @default(autoincrement())
  mobile        String    @unique @db.VarChar(15)
  name          String?   @db.VarChar(255)
  designation   String?   @db.VarChar(255)
  office        String?   @db.VarChar(255)
  district      String?   @db.VarChar(255)
  upazila       String?   @db.VarChar(255)
  role          String?   @db.VarChar(50) @default("SAAO") // SAAO, DD, MO, Monitor
  photoUrl      String?   @db.Text
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  submissions   Submission[]

  @@index([mobile])
  @@index([district])
  @@map("user_profiles")
}

model Submission {
  id                Int       @id @default(autoincrement())
  submissionId      String    @unique @map("submission_id") @db.VarChar(100)
  userProfileId     Int?      @map("user_profile_id")
  userProfile       UserProfile? @relation(fields: [userProfileId], references: [id])
  farmerName        String?   @map("farmer_name") @db.VarChar(255)
  farmerMobile      String?   @map("farmer_mobile") @db.VarChar(15)
  nurseryName       String?   @map("nursery_name") @db.VarChar(255)
  division          String?   @db.VarChar(255)
  region            String?   @db.VarChar(255)
  district          String?   @db.VarChar(255)
  upazila           String?   @db.VarChar(255)
  unionName         String?   @map("union_name") @db.VarChar(255)
  village           String?   @db.VarChar(255)
  block             String?   @db.VarChar(255)
  locationType      String?   @map("location_type") @db.VarChar(100)
  specificAddress   String?   @map("specific_address") @db.Text
  seedlingSource     String?   @map("seedling_source") @db.VarChar(255)
  latitude          Float?
  longitude         Float?
  plantingDate      String?   @map("planting_date") @db.VarChar(20)
  seedlingsJson     Json?     @map("seedlings_json") // Parsed seedling details array
  speciesSummary    String?   @map("species_summary") @db.Text // Human-readable summary
  totalSpecies      Int?      @map("total_species")
  totalSeedlings    Int?      @map("total_seedlings")
  initialNdvi       Float?    @map("initial_ndvi")
  photoUrl          String?   @map("photo_url") @db.Text
  photoSha256       String?   @map("photo_sha256") @db.VarChar(64)
  authHash          String?   @map("auth_hash") @db.VarChar(64)
  saaoName          String?   @map("saao_name") @db.VarChar(255)
  saaoMobile        String?   @map("saao_mobile") @db.VarChar(15)
  monitorName       String?   @map("monitor_name") @db.VarChar(255)
  monitorMobile     String?   @map("monitor_mobile") @db.VarChar(15)
  comments          String?   @db.Text
  source            String?   @db.VarChar(20) @default("app") // app, appscript, validation
  syncedAt          DateTime? @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  growthLogs        GrowthLog[]
  validationTasks   ValidationTask[]

  @@index([district])
  @@index([upazila])
  @@index([submissionId])
  @@index([userProfileId])
  @@index([syncedAt])
  @@map("submissions")
}

model GrowthLog {
  id            Int       @id @default(autoincrement())
  submissionId  String    @map("submission_id") @db.VarChar(100)
  submission    Submission @relation(fields: [submissionId], references: [submissionId])
  readingDate   String    @map("reading_date") @db.VarChar(20)
  ndviValue     Float     @map("ndvi_value")
  photoUrl      String?   @map("photo_url") @db.Text
  remarks       String?   @db.Text
  recordedBy    String?   @map("recorded_by") @db.VarChar(255)
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([readingDate])
  @@map("growth_logs")
}

model ValidationTask {
  id            Int       @id @default(autoincrement())
  taskId        String    @unique @map("task_id") @db.VarChar(100)
  submissionId  String    @map("submission_id") @db.VarChar(100)
  submission    Submission @relation(fields: [submissionId], references: [submissionId])
  siteId        String?   @map("site_id") @db.VarChar(100)
  saaoId        String?   @map("saao_id") @db.VarChar(100)
  saaoName      String?   @map("saao_name") @db.VarChar(255)
  decision      String?   @db.VarChar(20) // pending, approved, rejected
  remarks       String?   @db.Text
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([submissionId])
  @@index([decision])
  @@map("validation_tasks")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String   @db.VarChar(50)   // submission, user_profile, etc.
  entityId  String   @map("entity_id") @db.VarChar(100)
  action    String   @db.VarChar(50)   // APPROVE, REJECT, SYNC, etc.
  userId    String?  @map("user_id") @db.VarChar(100)
  userName  String?  @map("user_name") @db.VarChar(255)
  device    String?  @db.VarChar(500)
  gps       String?  @db.VarChar(50)   // "lat,lng"
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
