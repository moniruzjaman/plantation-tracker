# === DATABASE (Neon PostgreSQL) - AUTO on Vercel ===
# If you created the Neon store via Vercel Dashboard → Storage,
# POSTGRES_PRISMA_URL is auto-injected. No manual setup needed.
# For local dev, copy the value from Vercel → Settings → Environment Variables.
POSTGRES_PRISMA_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://plantation.krishiai.live"

# === Google Earth Engine (GEE) - OPTIONAL ===
# These are ONLY needed if you want REAL satellite NDVI data.
# Without these, the app uses realistic simulated data (works out of the box).
#
# HOW TO GET THESE (Free for non-commercial use):
# 1. Sign up at https://code.earthengine.google.com/
# 2. Go to https://console.cloud.google.com/ → Create a Service Account
# 3. Enable "Earth Engine API" in APIs & Services
# 4. Create a JSON key for the service account
# 5. Copy "client_email" → GEE_SERVICE_ACCOUNT_EMAIL
# 6. Copy "private_key" → GEE_SERVICE_ACCOUNT_KEY
#
# WHERE TO PUT THESE:
#   - Vercel: Project Settings → Environment Variables (recommended)
#   - Local:  Create .env.local (git-ignored, never committed)
GEE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GEE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
# === Google Apps Script (GAS) sync ===
# The /exec URL of your deployed Apps Script web app (Extensions > Apps Script
# on the actual editable spreadsheet > Deploy > New deployment > Web app).
# The client posts to /api/gas-sync (Vercel serverless), which forwards here.
GAS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec"

# Random 32+ char hex string used to HMAC-sign each submission row so the
# sheet can later verify authenticity. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example value (DO NOT use in production — generate your own):
AUTH_SECRET="d36673f8f455ae1874afd67a832f4bf560baaf5e988876e65694186a5f997d2b"

# === Weekly Report — Wednesday 9 AM BD cron + email ===
# A GitHub Actions workflow (.github/workflows/weekly-report.yml) runs
# scripts/cron_weekly_report.sh every Wednesday 09:00 Asia/Dhaka. The
# script fetches live data from GAS_WEBHOOK_URL, regenerates the report,
# and emails it via SMTP if the SMTP_* vars below are set.
#
# The dashboard tab also has a "🚀 রিপোর্ট পাঠান" button (added by PR #138)
# that calls /api/gas-sync?sendWeeklyReport=1&email=... — that uses
# GAS-side email sending (MailApp.sendEmail) and does NOT need SMTP_*.
# The SMTP_* vars below are ONLY for the GitHub Actions cron.
#
# For GitHub Actions, set these as GitHub Secrets (NOT in a .env file):
#   Repo → Settings → Secrets and variables → Actions → New repository secret
#
# Gmail: use an App Password (https://myaccount.google.com/apppasswords),
# not your regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=you@gmail.com
SMTP_TO=ddaekurigram@gmail.com,ddagrikuri@yahoo.com

# See scripts/README_CRON.md for full setup instructions.
