From f645f8394b979e697b983b2841109ae08a99963b Mon Sep 17 00:00:00 2001
From: Mithun <moniruzjaman@users.noreply.github.com>
Date: Sun, 30 Aug 2026 13:48:57 +0000
Subject: [PATCH] fix: officialReportCard Excel/HTML download links now follow
 actual report date

The Dashboard's Latest Official Weekly Report card hardcoded the Excel
and HTML download links to /reports/weekly-report-2026-08-11.*, while
the visible date label (officialReportDate) was already updated live
from the officialSummary API's reportDate field. Once a new dated
report is generated, the label would show the new date but the
download buttons would silently keep serving the stale Aug 11 file.

- Added ids to the Excel/HTML anchor tags (part1.txt)
- applyOfficialReportSummary() now derives the report date slug from
  data.reportDate and rewrites both anchors' href/download attributes
  to match (part5.txt): officialDateSlug() for the URL, and
  officialDateSlugBn() for the Bengali-numeral download filename,
  consistent with the existing GAS-side exportSpreadsheetAsXlsxBlob_()
  naming convention.
- Regenerated public/legacy/plantation.html via node map.js
---
 public/legacy/plantation.html | 12 ++++++++++--
 public/part1.txt              |  4 ++--
 public/part5.txt              |  8 ++++++++
 3 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/public/legacy/plantation.html b/public/legacy/plantation.html
index cab7f64..d9591df 100755
--- a/public/legacy/plantation.html
+++ b/public/legacy/plantation.html
@@ -486,8 +486,8 @@ tbody tr{border-bottom:1px solid #e5e7eb}
     <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full" style="background:#fef3c7;color:#92400e;border:1px solid #fde68a">✔ ডাটা মান যাচাইকৃত (উভয় উৎস একত্রীকৃত)</span>
   </div>
   <div class="flex flex-wrap items-center gap-2 mb-3">
-    <a href="/reports/weekly-report-2026-08-11.xlsx" download="সাপ্তাহিক_বৃক্ষরোপণ_প্রতিবেদন_২০২৬-০৮-১১.xlsx" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-md inline-flex items-center gap-1" style="background:#166534;color:#fff">⬇️ সম্পূর্ণ প্রতিবেদন (Excel)</a>
-    <a href="/reports/weekly-report-2026-08-11.html" target="_blank" rel="noopener" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-md inline-flex items-center gap-1" style="background:#fde68a;color:#78350f">📧 ইমেইল প্রিভিউ</a>
+    <a id="officialReportXlsxLink" href="/reports/weekly-report-2026-08-11.xlsx" download="সাপ্তাহিক_বৃক্ষরোপণ_প্রতিবেদন_২০২৬-০৮-১১.xlsx" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-md inline-flex items-center gap-1" style="background:#166534;color:#fff">⬇️ সম্পূর্ণ প্রতিবেদন (Excel)</a>
+    <a id="officialReportHtmlLink" href="/reports/weekly-report-2026-08-11.html" target="_blank" rel="noopener" class="text-[11px] font-semibold px-2.5 py-1.5 rounded-md inline-flex items-center gap-1" style="background:#fde68a;color:#78350f">📧 ইমেইল প্রিভিউ</a>
     <div class="inline-flex items-center gap-1 bg-white rounded-md border border-amber-300 p-0.5 shadow-sm">
       <span class="text-[11px] text-amber-800 font-semibold pl-1.5 hidden sm:inline">✉️</span>
       <input type="text" id="reportRecipientEmail" value="moniruzjamanlearner@gmail.com" placeholder="প্রাপকের ইমেইল (কমা দিয়ে একাধিক)..." class="text-[11px] px-2 py-1 outline-none text-gray-700 w-44 sm:w-56 bg-transparent" title="প্রতিবেদন পাঠানোর ইমেইল ঠিকানা (কমা দিয়ে একাধিক লিখতে পারেন)" />
@@ -3681,6 +3681,8 @@ function fetchOfficialReportSummary(force){
 function officialBnCount(n){n=Number(n)||0;return n.toLocaleString("bn-BD");}
 function officialBnPct(n){n=Number(n)||0;return n.toLocaleString("bn-BD",{minimumFractionDigits:2,maximumFractionDigits:2})+"%";}
 function officialDate(d){if(!d)return "";var dt=new Date(d);if(isNaN(dt.getTime()))return d;return dt.toLocaleDateString("bn-BD",{day:"numeric",month:"long",year:"numeric"});}
+function officialDateSlug(d){var dt=d?new Date(d):null;if(!dt||isNaN(dt.getTime()))dt=new Date();var y=dt.getFullYear();var m=String(dt.getMonth()+1).padStart(2,"0");var day=String(dt.getDate()).padStart(2,"0");return y+"-"+m+"-"+day;}
+function officialDateSlugBn(d){return officialDateSlug(d).split("-").map(function(part){return Number(part).toLocaleString("bn-BD",{minimumIntegerDigits:part.length,useGrouping:false});}).join("-");}
 function officialText(id,v){var el=document.getElementById(id);if(el)el.textContent=v;}
 function applyOfficialReportSummary(data){
   if(!data||!data.ok)return;
@@ -3696,6 +3698,12 @@ function applyOfficialReportSummary(data){
   officialText("rep17ColEntries",officialBnCount(s.seventeenColEntries));
   officialText("rep17ColCount",officialBnCount(s.seventeenColEntries));
   officialText("officialReportDate","("+officialDate(data.reportDate)+")");
+  var reportSlug=officialDateSlug(data.reportDate);
+  var reportSlugBn=officialDateSlugBn(data.reportDate);
+  var xlsxLink=document.getElementById("officialReportXlsxLink");
+  if(xlsxLink){xlsxLink.href="/reports/weekly-report-"+reportSlug+".xlsx";xlsxLink.download="সাপ্তাহিক_বৃক্ষরোপণ_প্রতিবেদন_"+reportSlugBn+".xlsx";}
+  var htmlLink=document.getElementById("officialReportHtmlLink");
+  if(htmlLink){htmlLink.href="/reports/weekly-report-"+reportSlug+".html";}
   var list=document.getElementById("repUpazilaList");
   if(list&&data.upazilaTrees){list.innerHTML=data.upazilaTrees.map(function(u){return '<span>'+u.label+": <b>"+officialBnCount(u.trees)+"</b></span>";}).join("");}
   var dq=document.getElementById("repDataList");
